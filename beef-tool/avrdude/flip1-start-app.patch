diff --git a/src/flip1.c b/src/flip1.c
--- a/src/flip1.c
+++ b/src/flip1.c
@@
 struct flip1
 {
   struct dfu_dev *dfu;
   unsigned char part_sig[3];
   unsigned char part_rev;
   unsigned char boot_ver;
+  int start_app;
   unsigned char security_mode_flag; /* indicates the user has already
                                      * been hinted about security
                                      * mode */
 };
@@
 static int flip1_open(PROGRAMMER *pgm, const char *port_spec);
+static int flip1_parseextparms(const PROGRAMMER *pgm, const LISTID extparms);
 static int flip1_initialize(const PROGRAMMER *pgm, const AVRPART *part);
@@
   pgm->open             = flip1_open;
   pgm->close            = flip1_close;
+  pgm->parseextparams   = flip1_parseextparms;
@@
 #ifdef HAVE_LIBUSB
 /* EXPORTED PROGRAMMER FUNCTION DEFINITIONS */
 
+static int flip1_parseextparms(const PROGRAMMER *pgm, const LISTID extparms) {
+  LNODEID ln;
+  const char *extended_param;
+  int rv = 0;
+
+  for (ln = lfirst(extparms); ln; ln = lnext(ln)) {
+    extended_param = ldata(ln);
+    if (strcmp(extended_param, "start_app") == 0) {
+      FLIP1(pgm)->start_app = 1;
+      continue;
+    }
+    pmsg_error("invalid extended parameter '%s'\n", extended_param);
+    rv = -1;
+  }
+  return rv;
+}
+
 int flip1_open(PROGRAMMER *pgm, const char *port_spec) {
@@
 void flip1_close(PROGRAMMER *pgm) {
   if (FLIP1(pgm)->dfu != NULL) {
+    if (FLIP1(pgm)->start_app) {
+      struct flip1_cmd cmd = {
+        FLIP1_CMD_WRITE_COMMAND, { 0x03, 0x00 }
+      };
+      struct dfu_status status;
+      pmsg_notice("starting application...\n");
+      (void) dfu_dnload(FLIP1(pgm)->dfu, &cmd, 3);
+      /*
+       * Atmel FLIP starts the application while processing GETSTATUS.
+       * The USB device normally disappears immediately, so an error here is
+       * expected and must not turn a successful START_APP into a failure.
+       */
+      (void) dfu_getstatus(FLIP1(pgm)->dfu, &status);
+    }
     dfu_close(FLIP1(pgm)->dfu);
     FLIP1(pgm)->dfu = NULL;
   }
 }
